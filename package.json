{
  "name": "uicapsule",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "db:push": "pnpm -F db push",
    "db:push-remote": "pnpm -F db push:remote",
    "dev": "turbo watch dev --continue",
    "dev:web": "turbo watch dev -F @repo/web...",
    "dev:extension": "pnpm -F @repo/extension dev",
    "lint": "oxlint --report-unused-disable-directives",
    "test": "turbo run test && node --import tsx --test 'scripts/**/*.test.ts'",
    "typecheck": "turbo run typecheck && pnpm typecheck:scripts && pnpm typecheck:content",
    "format": "oxfmt --check",
    "lint:fix": "oxlint --fix",
    "format:fix": "oxfmt --write",
    "new:content": "node --import tsx scripts/new-content.ts",
    "check:content": "node --import tsx scripts/check-content.ts",
    "build:previews": "node --import tsx scripts/build-previews.ts",
    "dev:previews": "node --import tsx scripts/build-previews.ts --watch",
    "check:agent-endpoints": "node --import tsx scripts/check-agent-endpoints.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm format && pnpm test && pnpm build",
    "typecheck:content": "node --import tsx scripts/typecheck-content.ts",
    "typecheck:scripts": "tsc --project tsconfig.scripts.json",
    "og:video": "node --import tsx scripts/og-video.ts",
    "skills:sync": "DISABLE_TELEMETRY=1 skills experimental_install --frozen-lockfile --force --agent claude-code",
    "skills:update": "DISABLE_TELEMETRY=1 skills update --project --yes"
  },
  "devDependencies": {
    "@interfere/landmines": "^0.1.1",
    "@kyh/tsconfig": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@vercel/blob": "^2.9.0",
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "dotenv-cli": "^11.1.0",
    "esbuild": "^0.28.2",
    "oxc-parser": "^0.154.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.94.0",
    "playwright": "1.65.1",
    "postcss": "^8.5.33",
    "skills": "1.9.0",
    "tsx": "catalog:",
    "turbo": "^2.11.13",
    "typescript": "catalog:",
    "ultracite": "^8.3.1"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.3.4"
}
