{
  "name": "uicapsule",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "db:push": "pnpm -F db push",
    "db:push-remote": "pnpm -F db push:remote",
    "dev": "turbo watch dev --continue",
    "dev:web": "turbo watch dev -F @repo/web...",
    "lint": "oxlint --report-unused-disable-directives",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "oxfmt --check",
    "lint:fix": "oxlint --fix",
    "format:fix": "oxfmt --write",
    "new:content": "tsx scripts/new-content.ts",
    "check:content": "tsx scripts/check-content.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm format && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@kyh/oxlint": "^0.2.0",
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "dotenv-cli": "^11.0.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "tsx": "catalog:",
    "turbo": "^2.10.12",
    "typescript": "catalog:"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.3.4"
}
