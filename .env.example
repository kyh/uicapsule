# Local dev: run `pnpm -F db db` (turso dev) and point at it — no auth token needed.
# Production: the Turso cloud URL + token.
TURSO_DATABASE_URL="http://127.0.0.1:8080"
TURSO_AUTH_TOKEN=""

# Any random string; signs better-auth sessions.
BETTER_AUTH_SECRET="local-only-better-auth-secret-0000000000"
# Optional local origin override; match the dev server port.
BETTER_AUTH_URL="http://localhost:3000"

# Public origin of the `uicapsule-assets` Vercel Blob store (covers, illustrations). The value
# below is the real one — every content/*/meta.json `cover` key resolves against it.
# Required: apps/web/src/lib/assets.ts throws without it, and next.config.ts builds
# images.remotePatterns from it. Keep it listed in turbo.json globalEnv too, or turbo's
# strict env mode strips it from the build with no error.
NEXT_PUBLIC_ASSETS_URL="https://d24l2zb4cwkekfpl.public.blob.vercel-storage.com"

# Sign-in code delivery. Set both in production; use a verified Resend sender. Unset in
# dev, the mail and its code go to the server log; unset in production, nothing is sent
# or logged and sign-in by email code is refused.
RESEND_API_KEY=""
AUTH_EMAIL_FROM=""

# Fine-grained GitHub token on kyh/uicapsule: Issues read & write (files requests) plus
# whatever "write access" the user-attachments upload endpoint needs. Unset = the form
# reports "temporarily unavailable"; the GitHub issue template still works.
GITHUB_ISSUES_TOKEN=""

# Browser-extension origins allowed to file requests (comma-separated). The first is the
# unpacked dev build of apps/extension, pinned by the `key` in its wxt.config.ts; add the Chrome
# Web Store build's chrome-extension://<id> in production.
EXTENSION_ORIGINS="chrome-extension://gndnanbepebpjjifhogmdlabbpddfgml"

# Origin that serves component previews (/preview-frame/<slug> + /previews/*), e.g.
# https://preview.uicapsule.com, an alias of this same Vercel project. Unset = this origin.
# Previews are sandboxed (opaque origin) either way; a separate host keeps preview code off
# www's site entirely. Keep it listed in turbo.json globalEnv.
NEXT_PUBLIC_PREVIEW_URL=""

# The request builder (apps/web/agent, an eve agent served beside the site at /agent/v1/*). A GitHub
# App on kyh/uicapsule with Contents, Issues and Pull requests read & write, subscribed to Issues
# and Issue comment events, its webhook at https://<site>/agent/v1/github. Unset = the webhook route
# answers 401 and nothing builds. The agent's sandbox and model run on the Vercel project's own
# credentials (OIDC), so there is no AI key here.
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""
GITHUB_APP_SLUG=""
# The `uicapsule-assets` store's read-write token: the builder uploads covers with it.
BLOB_READ_WRITE_TOKEN=""
