{
  "name": "@repo/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./drizzle-client": "./src/drizzle-client.ts",
    "./drizzle-schema-auth": "./src/drizzle-schema-auth.ts",
    "./drizzle-schema-ugc": "./src/drizzle-schema-ugc.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "typecheck": "tsc --noEmit",
    "db": "turso dev --db-file local.db",
    "studio": "pnpm with-env drizzle-kit studio",
    "push": "pnpm with-env drizzle-kit push --force",
    "generate:auth-schema": "echo 'Disabled. @better-auth/cli is stuck at 1.4.21: it strips hand-added indexes, RLS, and the rate_limit table. Running it silently breaks auth. Maintain src/drizzle-schema-auth.ts by hand until the CLI supports 1.7.' && exit 1",
    "push:remote": "dotenv -e ../../.env.production.local -- drizzle-kit push",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@kyh/tsconfig": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:"
  }
}
