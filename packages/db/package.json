{
  "name": "@repo/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo node_modules",
    "typecheck": "tsc --noEmit",
    "db": "turso dev --db-file local.db",
    "studio": "pnpm with-env drizzle-kit studio",
    "push": "pnpm with-env drizzle-kit push --force",
    "generate:auth-schema": "echo 'Disabled. @better-auth/cli is stuck at 1.4.21: it emits no account.issuer (required since better-auth 1.7) and strips hand-added indexes, RLS, and the rate_limit table. Running it silently breaks auth. Maintain src/drizzle-schema-auth.ts by hand until the CLI supports 1.7.' && exit 1",
    "push:remote": "dotenv -e ../../.env.production.local -- drizzle-kit push",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "drizzle-orm": "^0.45.2",
    "next": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@kyh/tsconfig": "catalog:",
    "@types/react": "catalog:",
    "drizzle-kit": "^0.31.10",
    "typescript": "catalog:"
  }
}
